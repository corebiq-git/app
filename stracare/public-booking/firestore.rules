rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    function isAdmin() {
      return signedIn() && getUserData().role == 'admin';
    }

    function isUserBranch(docBranch) {
      return signedIn() && getUserData().branch == docBranch;
    }

    match /users/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow read, write, delete: if isAdmin();
    }

    match /settings/company_profile {
      allow get: if signedIn();
      allow write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow get, list: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /branches/{document=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /booking_requests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'mobile', 'branch', 'date', 'time', 'notes', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'mobile', 'branch', 'date', 'time', 'notes', 'status', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.mobile is string
        && request.resource.data.mobile.matches('^[0-9]{10}$')
        && request.resource.data.branch is string
        && request.resource.data.branch.size() > 0
        && request.resource.data.branch.size() <= 100
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time is string
        && request.resource.data.time.matches('^(0[9]|1[0-9]|20):[0-5][0-9]$|^21:00$')
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow get, list: if isAdmin() || isUserBranch(resource.data.branch);
      allow update: if isAdmin()
        || (isUserBranch(resource.data.branch)
          && request.resource.data.branch == resource.data.branch
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'appointmentId', 'patientMatch', 'reviewedAt'
          ])
          && request.resource.data.status in ['converted', 'declined']
          && request.resource.data.reviewedAt == request.time);
      allow delete: if isAdmin();
    }

    match /staff/{document=**} {
      allow read, write, delete: if isAdmin();
      allow read: if isUserBranch(resource.data.branch);
      allow create: if isUserBranch(request.resource.data.branch);
      allow update: if isUserBranch(resource.data.branch)
        && isUserBranch(request.resource.data.branch);
    }

    match /appointments/{document=**} {
      allow read, write, delete: if isAdmin();
      allow read: if isUserBranch(resource.data.branch);
      allow create: if isUserBranch(request.resource.data.branch);
      allow update: if isUserBranch(resource.data.branch)
        && isUserBranch(request.resource.data.branch);
    }

    match /patients/{document=**} {
      allow read, write, delete: if isAdmin();
      allow read: if isUserBranch(resource.data.branch);
      allow create: if isUserBranch(request.resource.data.branch);
      allow update: if isUserBranch(resource.data.branch)
        && isUserBranch(request.resource.data.branch);
    }

    match /transactions/{document=**} {
      allow read, write, delete: if isAdmin();
      allow read: if isUserBranch(resource.data.branch);
      allow create: if isUserBranch(request.resource.data.branch);
      allow update: if isUserBranch(resource.data.branch)
        && isUserBranch(request.resource.data.branch);
    }

    match /therapists/{document=**} {
      allow read, write, delete: if isAdmin();
      allow read: if isUserBranch(resource.data.branch);
      allow create: if isUserBranch(request.resource.data.branch);
      allow update: if isUserBranch(resource.data.branch)
        && isUserBranch(request.resource.data.branch);
    }

    match /daily_attendance/{document=**} {
      allow read, write, delete: if isAdmin();
      allow read: if isUserBranch(resource.data.branch);
      allow create: if isUserBranch(request.resource.data.branch);
      allow update: if isUserBranch(resource.data.branch)
        && isUserBranch(request.resource.data.branch);
    }
  }
}
